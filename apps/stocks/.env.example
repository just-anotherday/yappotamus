# =============================================================
# YapVibes Stocks Backend - Environment Configuration
# =============================================================
# Copy to .env and fill in real values.
# NEVER commit .env with real secrets.
# =============================================================

# ------------------------------------------------------------------
# Access Control (single-user access protection)
# ------------------------------------------------------------------
# Shared secret required as `Authorization: Bearer <token>` on every API
# request. This is a password you choose, NOT an OpenAI key. Required in
# every environment - the app refuses to start without it.
APP_ACCESS_TOKEN=replace_with_private_token

# Dedicated machine-to-machine token for POST /internal/jobs/news-ingest.
# Configure this separately from browser access tokens; never commit its value.
# INTERNAL_JOB_TOKEN=replace_with_internal_job_token

# ------------------------------------------------------------------
# Database (Supabase PostgreSQL for production)
# ------------------------------------------------------------------
# Development:  postgresql+asyncpg://postgres:password@localhost:5432/news
# Production:   postgresql+asyncpg://<user>:<pass>@<project>.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/news

# Database pool size - defaults to 3 (deployment-safe for providers with ~15 session limit)
DB_POOL_SIZE=3

# Database max overflow - defaults to 2 (total per-process = DB_POOL_SIZE + DB_MAX_OVERFLOW)
DB_MAX_OVERFLOW=2

# Maximum seconds to wait for acquiring a connection from the pool - defaults to 10
DB_POOL_TIMEOUT=10

# ------------------------------------------------------------------
# AI Provider Selection
# ------------------------------------------------------------------
# Options: ollama (default, local dev), openai (production)
AI_PROVIDER=ollama

# Ollama (local development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SMALL_S=900
OLLAMA_TIMEOUT_LARGE_S=1200
OLLAMA_MAX_RETRIES=3

# OpenAI (production)
OPENAI_API_KEY=replace_with_openai_key
OPENAI_MODEL=gpt-4o-mini
# Comma-separated whitelist - the ONLY models callable via the openai provider.
# Cost control: OPENAI_MODEL must be a member of this list.
OPENAI_ALLOWED_MODELS=gpt-4o-mini

# ------------------------------------------------------------------
# Market Data
# ------------------------------------------------------------------
FINNHUB_API_KEY=your_finnhub_api_key_here
# Production default is false: GitHub Actions is the authoritative scheduler.
# Set true only for local-development convenience.
NEWS_SCHEDULER_ENABLED=false
# Per-provider timeout before Finnhub/yfinance fallback (seconds).
MARKET_DATA_PROVIDER_TIMEOUT_S=20
# Fresh in-memory fundamentals cache and provider-failure stale window.
HYBRID_CACHE_TTL_S=300
HYBRID_STALE_CACHE_TTL_S=3600
HYBRID_CACHE_MAX_SIZE=1000
# Optional. Defaults to a writable OS temporary directory. On Render this
# remains ephemeral unless the configured path is under an attached disk.
# YFINANCE_CACHE_DIR=/var/data/yfinance-cache

# ------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yapvibes.com,https://stocks.yapvibes.com,https://projects.yapvibes.com,https://yapvibes-stocks.pages.dev

# ------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_MAX_REQUESTS=20

# ------------------------------------------------------------------
# Article Intelligence Maintenance CLI
# ------------------------------------------------------------------
MAINTENANCE_PRODUCTION_URL=https://stocks.example.com
MAINTENANCE_API_TOKEN=replace_with_separate_maintenance_token
MAINTENANCE_RUN_STORE_PATH=.maintenance/article-intelligence.sqlite3
MAINTENANCE_OLLAMA_MODEL=llama3.2
MAINTENANCE_HTTP_TIMEOUT_S=30

# ------------------------------------------------------------------
# AI Worker
# ------------------------------------------------------------------
AI_WORKER_POLL_INTERVAL_S=10
AI_WORKER_MAX_CONCURRENT=2
# Lease-based interrupted-job recovery. The stale threshold should remain
# longer than the longest configured job timeout (currently 30 minutes).
AI_JOB_LEASE_SECONDS=120
AI_JOB_HEARTBEAT_SECONDS=30
AI_STALE_JOB_THRESHOLD_SECONDS=3600
# Keep disabled until protected production diagnostics confirm stale timestamps.
AI_STALE_JOB_RECOVERY_ENABLED=false
AI_WORKER_QUEUE_TIMEOUT_S=1800

# ------------------------------------------------------------------
# Analysis Timeout
# ------------------------------------------------------------------
ANALYSIS_TIMEOUT_S=900

# ------------------------------------------------------------------
# WebSocket Reconnect Settings
# ------------------------------------------------------------------
WS_RECONNECT_BACKOFF_S=1
WS_RECONNECT_MAX_BACKOFF_S=30
WS_INITIAL_DELAY_S=2.0
WS_PING_INTERVAL_S=30.0
WS_PING_TIMEOUT_S=10.0

# ------------------------------------------------------------------
# Quote Cache
# ------------------------------------------------------------------
QUOTE_CACHE_MAX_SIZE=256
LIVE_PRICE_POLL_S=15
MARKET_DATA_BATCH_SIZE=50
PM_FETCH_INTERVAL_S=30
PM_MAX_CONCURRENCY=3
MARKET_DATA_BACKOFF_INITIAL_S=5
MARKET_DATA_BACKOFF_MAX_S=120
MARKET_DATA_JITTER_S=1.0
# Free-tier hard limit is 60/min; YapVibes intentionally reserves 25%.
FINNHUB_REQUESTS_PER_MINUTE=45
FINNHUB_MAX_RETRY_ATTEMPTS=3
FINNHUB_BACKOFF_INITIAL_S=1.0
FINNHUB_BACKOFF_MAX_S=30.0
FINNHUB_RETRY_JITTER_S=0.5
FINNHUB_MAX_RETRY_AFTER_S=120

# External triggers provide 15-minute weekday active-hours coverage plus an
# hourly baseline. The service enforces New York cadence and bounded recovery.
NEWS_ACTIVE_INTERVAL_MINUTES=15
NEWS_OFF_HOURS_INTERVAL_MINUTES=60
NEWS_OVERLAP_MINUTES=30
NEWS_INITIAL_BACKFILL_HOURS=24
NEWS_MAX_BACKFILL_HOURS=72
NEWS_INGESTION_LEASE_MINUTES=20
NEWS_STALE_AFTER_MINUTES=90
NEWS_ENQUEUE_COMPANY_REPORTS=false
# Deprecated compatibility setting; regular quotes now use batched downloads.
YF_PER_TICKER_DELAY_S=0.6

# ------------------------------------------------------------------
# Hybrid Data Cache
# ------------------------------------------------------------------
HYBRID_CACHE_TTL_S=300
HYBRID_CACHE_MAX_SIZE=1000
