# Stocks Frontend API Configuration
# Set these to point to your backend server
# For local development, the backend runs on http://localhost:8000

NEXT_PUBLIC_API_BASE=http://localhost:8000
# Optional override. When omitted, this is derived from NEXT_PUBLIC_API_BASE.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# The reports page always offers both v2.0 and v3.0 prompt versions.
